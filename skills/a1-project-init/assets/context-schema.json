{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "project-context",
  "type": "object",
  "required": [
    "version",
    "project",
    "tech_stack",
    "team",
    "settings"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "project": {
      "type": "object",
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "client": {
          "type": "string"
        },
        "type": {
          "enum": [
            "mobile_app",
            "web_app",
            "web_admin",
            "api_only",
            "fullstack"
          ]
        },
        "description": {
          "type": "string"
        },
        "start_date": {
          "type": "string"
        },
        "go_live_target": {
          "type": "string"
        },
        "current_sprint": {
          "type": "integer",
          "minimum": 0
        },
        "current_phase": {
          "type": "string"
        }
      }
    },
    "tech_stack": {
      "type": "object",
      "properties": {
        "backend": {
          "type": "string"
        },
        "database": {
          "type": "string"
        },
        "cache": {
          "type": "string"
        },
        "mobile": {
          "type": "string"
        },
        "admin_cms": {
          "type": "string"
        },
        "auth": {
          "type": "string"
        },
        "hosting": {
          "type": "string"
        },
        "ci_cd": {
          "type": "string"
        },
        "monitoring": {
          "type": "string"
        },
        "push_notification": {
          "type": "string"
        }
      }
    },
    "integrations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      }
    },
    "team": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "role"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "allocation": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "md_per_sprint": {
            "type": "number",
            "minimum": 0
          },
          "side": {
            "enum": [
              "vendor",
              "client"
            ],
            "description": "vendor = đội dự án; client = stakeholder phía khách (mặc định vendor)"
          },
          "email": {
            "type": "string"
          }
        }
      }
    },
    "settings": {
      "type": "object",
      "properties": {
        "sprint_duration_weeks": {
          "type": "number",
          "minimum": 1
        },
        "working_days_per_week": {
          "type": "number",
          "minimum": 1,
          "maximum": 7
        },
        "md_per_person_month": {
          "type": "number",
          "minimum": 1
        },
        "buffer_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "languages": {
          "type": "object",
          "description": "Ngôn ngữ deliverable — xem references/i18n-policy.md",
          "properties": {
            "client_facing": {
              "type": "string",
              "enum": [
                "vi",
                "en",
                "ja"
              ]
            },
            "internal": {
              "type": "string",
              "enum": [
                "vi",
                "en",
                "ja"
              ]
            },
            "code": {
              "type": "string",
              "enum": [
                "vi",
                "en",
                "ja"
              ]
            }
          }
        },
        "quality_gates": {
          "type": "object",
          "description": "Ngưỡng chất lượng dùng chung — nguồn duy nhất cho c1/c5/c8. Mặc định xem pipeline.md",
          "properties": {
            "ut_pass_rate": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "default": 95
            },
            "ut_coverage_line": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "default": 80
            },
            "ut_coverage_branch": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "default": 70
            },
            "it_pass_rate": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "default": 95
            },
            "st_pass_rate": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "default": 98
            },
            "open_critical_high_max": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          }
        }
      }
    },
    "estimates": {
      "type": "object",
      "properties": {
        "total_md": {
          "type": "number"
        },
        "total_sprints": {
          "type": "integer"
        },
        "team_capacity_per_sprint": {
          "type": "number"
        },
        "buffer_percent": {
          "type": "number"
        }
      }
    },
    "links": {
      "type": "object",
      "description": "Đường dẫn/URL liên quan. Khóa chuẩn: git_repo, production_url, staging_url, architecture_file, prototype_file, basic_design_doc, basic_design_approved (ngày ký YYYY-MM-DD), api_design_file, db_design_file",
      "additionalProperties": {
        "type": "string"
      }
    },
    "change_requests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "description": "pending | received | in analysis | negotiating | approved | rejected | deferred"
          },
          "impact_md": {
            "type": "number"
          },
          "date": {
            "type": "string"
          }
        }
      }
    },
    "known_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "severity",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "description": "Critical | High | Medium | Low (thang chuẩn trong pipeline.md)"
          },
          "status": {
            "type": "string",
            "description": "open | in progress | fixed | retest | verified | closed | wontfix"
          },
          "found_in": {
            "type": "string"
          },
          "date": {
            "type": "string"
          }
        }
      }
    },
    "activity_log": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "skill",
          "date"
        ],
        "properties": {
          "skill": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "release": {
      "type": "object",
      "description": "Ghi bởi c8-release-deployment sau khi phát hành",
      "properties": {
        "version": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "rollback_hash": {
          "type": "string"
        }
      }
    }
  }
}
