{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "project-context",
  "type": "object",
  "required": [
    "version",
    "project",
    "tech_stack",
    "team",
    "settings"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "project": {
      "type": "object",
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "client": {
          "type": "string"
        },
        "type": {
          "enum": [
            "mobile_app",
            "web_app",
            "web_admin",
            "api_only",
            "fullstack"
          ]
        },
        "description": {
          "type": "string"
        },
        "start_date": {
          "type": "string"
        },
        "go_live_target": {
          "type": "string"
        },
        "current_sprint": {
          "type": "integer",
          "minimum": 0
        },
        "current_phase": {
          "type": "string"
        }
      }
    },
    "tech_stack": {
      "type": "object",
      "properties": {
        "backend": {
          "type": "string"
        },
        "database": {
          "type": "string"
        },
        "cache": {
          "type": "string"
        },
        "mobile": {
          "type": "string"
        },
        "admin_cms": {
          "type": "string"
        },
        "auth": {
          "type": "string"
        },
        "hosting": {
          "type": "string"
        },
        "ci_cd": {
          "type": "string"
        },
        "monitoring": {
          "type": "string"
        },
        "push_notification": {
          "type": "string"
        }
      }
    },
    "integrations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      }
    },
    "team": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "role"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "allocation": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "md_per_sprint": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "settings": {
      "type": "object",
      "properties": {
        "sprint_duration_weeks": {
          "type": "number",
          "minimum": 1
        },
        "working_days_per_week": {
          "type": "number",
          "minimum": 1,
          "maximum": 7
        },
        "md_per_person_month": {
          "type": "number",
          "minimum": 1
        },
        "buffer_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "languages": {
          "type": "object",
          "description": "Ngôn ngữ deliverable — xem references/i18n-policy.md",
          "properties": {
            "client_facing": {
              "type": "string",
              "enum": [
                "vi",
                "en",
                "ja"
              ]
            },
            "internal": {
              "type": "string",
              "enum": [
                "vi",
                "en",
                "ja"
              ]
            },
            "code": {
              "type": "string",
              "enum": [
                "vi",
                "en",
                "ja"
              ]
            }
          }
        }
      }
    },
    "estimates": {
      "type": "object"
    },
    "links": {
      "type": "object"
    },
    "change_requests": {
      "type": "array"
    },
    "known_issues": {
      "type": "array"
    },
    "activity_log": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "skill",
          "date"
        ],
        "properties": {
          "skill": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
